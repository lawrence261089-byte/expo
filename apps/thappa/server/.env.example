# ============================================================
# THAPPA SERVER — ENVIRONMENT VARIABLES (EXAMPLE)
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- WhatsApp Business API ---
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
WHATSAPP_API_VERSION=v18.0

# --- Google Sheets ---
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# Path to the downloaded JSON key file for the service account
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account-key.json

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Support ---
# WhatsApp number that receives HELP escalations (E.164 format, no +)
SUPPORT_WHATSAPP_NUMBER=91XXXXXXXXXX
SUPPORT_REPLY_HOURS=2

# --- UPI Payment ---
UPI_ID=thappa@upi
UPI_NAME=Thappa
CHECK_PRICE_INR=10
SUBSCRIPTION_PRICE_INR=99
FREE_CHECKS_PER_USER=10

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# --- Logging ---
LOG_LEVEL=info
