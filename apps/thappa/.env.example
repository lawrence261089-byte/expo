# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ─── WhatsApp Business API (Meta Cloud API) ───────────────────────────────────
# Get these from: https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WHATSAPP_VERIFY_TOKEN=thappa_verify_token_2024

# ─── Google Sheets Database ───────────────────────────────────────────────────
# Create a Google Cloud service account and share the spreadsheet with it
# Paste the entire service account JSON as a single line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"..."}
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# ─── Admin Dashboard ──────────────────────────────────────────────────────────
# Set a strong random key for the admin API
ADMIN_API_KEY=change_this_to_a_strong_random_key

# ─── Business Config ──────────────────────────────────────────────────────────
# UPI ID for payment collection (no real number stored here)
UPI_ID=thappa@upi

# Support configuration
SUPPORT_PHONE=
SUPPORT_HOURS=9 AM – 9 PM IST
SUPPORT_TOLL_FREE=1800-XXX-XXXX

# Free checks per user before payment required
FREE_CHECKS_PER_USER=10

# ─── Security ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com
